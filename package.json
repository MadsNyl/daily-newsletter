{
  "name": "daily-newsletter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "dotenvx run -- pnpm --filter @daily-newsletter/api dev",
    "dev:worker": "dotenvx run -- pnpm --filter @daily-newsletter/worker dev",
    "dev:web": "dotenvx run -- pnpm --filter @daily-newsletter/web dev",
    "dev": "dotenvx run -- pnpm --parallel --recursive --filter @daily-newsletter/api --filter @daily-newsletter/worker --filter @daily-newsletter/web run dev",
    "build": "pnpm run --recursive build",
    "lint": "pnpm run --recursive lint",
    "lint:fix": "pnpm run --recursive lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "pnpm run --recursive typecheck",
    "check": "pnpm run lint && pnpm run typecheck",
    "db:generate": "dotenvx run -- pnpm --filter @daily-newsletter/api db:generate",
    "db:migrate": "dotenvx run -- pnpm --filter @daily-newsletter/api db:migrate",
    "db:push": "dotenvx run -- pnpm --filter @daily-newsletter/api db:push",
    "db:studio": "dotenvx run -- pnpm --filter @daily-newsletter/api db:studio",
    "db:studio:prod": "dotenvx run -f .env.production -- pnpm --filter @daily-newsletter/api db:studio",
    "db:seed": "dotenvx run -- pnpm --filter @daily-newsletter/api db:seed",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
